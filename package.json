{
  "name": "tailwind-nextjs-starter-blog",
  "version": "2.4.0",
  "private": true,
  "scripts": {
    "start": "next dev",
    "dev": "cross-env NODE_OPTIONS='--max-old-space-size=4096' INIT_CWD=$PWD next dev",
    "build": "(prisma migrate deploy || echo 'Migrations skipped or already applied') && cross-env INIT_CWD=$PWD next build && cross-env NODE_OPTIONS='--experimental-json-modules' node ./scripts/postbuild.mjs",
    "serve": "next start",
    "analyze": "cross-env ANALYZE=true next build",
    "lint": "next lint --fix --dir pages --dir app --dir components --dir lib --dir layouts --dir scripts",
    "prepare": "husky",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset --force && yarn db:seed"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.71.2",
    "@celo/contractkit": "^3.2.0",
    "@celo/react-celo": "^5.0.4",
    "@google/generative-ai": "latest",
    "@headlessui/react": "2.2.0",
    "@next/bundle-analyzer": "15.2.6",
    "@noble/hashes": "latest",
    "@prisma/client": "^6.16.2",
    "@privy-io/react-auth": "^3.15.0",
    "@privy-io/wagmi": "^4.0.2",
    "@react-email/components": "^1.0.1",
    "@scure/bip32": "latest",
    "@scure/bip39": "latest",
    "@solana-program/memo": "^0.11.0",
    "@solana-program/system": "^0.12.0",
    "@solana-program/token": "^0.11.0",
    "@solana/kit": "^6.1.0",
    "@supabase/supabase-js": "^2.106.1",
    "@tailwindcss/forms": "^0.5.9",
    "@tailwindcss/postcss": "^4.0.5",
    "@tailwindcss/typography": "^0.5.15",
    "@tanstack/react-query": "^5.90.8",
    "@types/qrcode": "^1.5.5",
    "@wagmi/core": "^2.22.1",
    "bcryptjs": "^3.0.2",
    "body-scroll-lock": "^4.0.0-beta.0",
    "contentlayer2": "0.5.5",
    "esbuild": "0.25.2",
    "ethers": "^6.15.0",
    "github-slugger": "^2.0.0",
    "gray-matter": "^4.0.2",
    "hast-util-from-html-isomorphic": "^2.0.0",
    "html2canvas": "^1.4.1",
    "image-size": "2.0.1",
    "jose": "^6.1.0",
    "jspdf": "^4.0.0",
    "next": "15.2.6",
    "next-contentlayer2": "0.5.5",
    "next-themes": "^0.4.6",
    "node-fetch": "^2.7.0",
    "pliny": "0.4.1",
    "postcss": "^8.4.24",
    "prisma": "^6.16.2",
    "qrcode": "^1.5.4",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-markdown": "^10.1.0",
    "reading-time": "1.5.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-citation": "^2.3.0",
    "rehype-katex": "^7.0.0",
    "rehype-katex-notranslate": "^1.1.4",
    "rehype-preset-minify": "7.0.0",
    "rehype-prism-plus": "^2.0.0",
    "rehype-slug": "^6.0.0",
    "remark": "^15.0.0",
    "remark-gfm": "^4.0.0",
    "remark-github-blockquote-alert": "^1.2.1",
    "remark-math": "^6.0.0",
    "resend": "^6.5.2",
    "tailwindcss": "^4.0.5",
    "unist-util-visit": "^5.0.0",
    "viem": "^2.39.0",
    "wagmi": "^2.19.3",
    "web3": "^1.3.6",
    "yet-another-react-lightbox": "^3.31.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.16.0",
    "@svgr/webpack": "^8.0.1",
    "@types/bcryptjs": "^3.0.0",
    "@types/mdx": "^2.0.12",
    "@types/react": "^19.0.8",
    "@typescript-eslint/eslint-plugin": "^8.12.0",
    "@typescript-eslint/parser": "^8.12.0",
    "cross-env": "^7.0.3",
    "eslint": "^9.14.0",
    "eslint-config-next": "15.2.6",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.0",
    "globals": "^15.12.0",
    "husky": "^9.0.0",
    "lint-staged": "^13.0.0",
    "prettier": "^3.0.0",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "tsx": "^4.20.5",
    "typescript": "^5.1.3"
  },
  "lint-staged": {
    "*.+(js|jsx|ts|tsx)": [
      "eslint --fix"
    ],
    "*.+(js|jsx|ts|tsx|json|css|md|mdx)": [
      "prettier --write"
    ]
  },
  "packageManager": "yarn@3.6.1"
}
