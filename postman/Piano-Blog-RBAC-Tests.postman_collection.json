        {
          "name": "Validator 3 - Approve Venue (Auto-Verify)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Venue auto-verified\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.success).to.be.true;",
                  "    pm.expect(jsonData.venue.verified).to.be.true;",
                  "    pm.expect(jsonData.message).to.include(\"automatically verified\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{validator3_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"approved\": true,\n  \"notes\": \"Validator 3 approves - should auto-verify\",\n  \"rating\": 5\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/venues/{{test_venue_id}}/validate",
              "host": ["{{base_url}}"],
              "path": ["api", "venues", "{{test_venue_id}}", "validate"]
            }
          }
        },
        {
          "name": "Get Validation Status",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"3 approvals recorded\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.validationStatus.approved).to.eql(3);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/venues/{{test_venue_id}}/validate",
              "host": ["{{base_url}}"],
              "path": ["api", "venues", "{{test_venue_id}}", "validate"]
            }
          }
        }
      ]
