    {
      "name": "02 - Scout Tests (Create Venues Only)",
      "item": [
        {
          "name": "Scout - Create Venue (Should Succeed)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 or 201\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "});",
                  "pm.test(\"Venue created\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.success).to.be.true;",
                  "    if (jsonData.venue && jsonData.venue.id) {",
                  "        pm.collectionVariables.set(\"test_venue_id\", jsonData.venue.id);",
                  "    }",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{scout_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test Venue for RBAC\",\n  \"city\": \"Toronto\",\n  \"address\": \"123 Test St\",\n  \"contactInfo\": \"test@venue.com\",\n  \"hasPiano\": true,\n  \"description\": \"Test venue for role testing\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/venues",
              "host": ["{{base_url}}"],
              "path": ["api", "venues"]
            }
          }
        },
        {
          "name": "Scout - Read All Venues (Should Succeed)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Can read venues\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.success).to.be.true;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{scout_token}}" }],
            "url": {
              "raw": "{{base_url}}/api/venues",
              "host": ["{{base_url}}"],
              "path": ["api", "venues"]
            }
          }
        },
        {
          "name": "Scout - Update Venue (Should Fail)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 403\", function () {",
                  "    pm.response.to.have.status(403);",
                  "});",
                  "pm.test(\"Access denied\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.success).to.be.false;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{scout_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"description\": \"Updated description\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/venues/{{test_venue_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "venues", "{{test_venue_id}}"]
            }
          }
        },
        {
          "name": "Scout - Delete Venue (Should Fail)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 403\", function () {",
                  "    pm.response.to.have.status(403);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{scout_token}}" }],
