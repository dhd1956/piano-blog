// Simplified Prisma schema - PostgreSQL only for content, blockchain only for payments
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Simplified venue model - PostgreSQL-only, no blockchain sync
model Venue {
  id           Int      @id @default(autoincrement())
  slug         String   @unique // URL-friendly identifier

  // Basic venue information
  name         String
  city         String
  contactInfo  String
  contactType  String   @default("email")
  submittedBy  String   // Wallet address of scout
  hasPiano     Boolean  @default(false)
  hasJamSession Boolean @default(false)
  venueType    Int      @default(0) // Enum: 0=Cafe, 1=Restaurant, 2=Bar, etc.

  // Rich PostgreSQL-only fields
  description  String?  @db.Text // Rich text description
  address      String?  // Physical address
  latitude     Float?   // For geolocation
  longitude    Float?   // For geolocation
  phone        String?  // Phone number
  website      String?  // Website URL
  socialLinks  Json?    // Social media links as JSON
  amenities    String[] // Array of amenities
  tags         String[] // Searchable tags
  priceRange   String?  // Price range indicator

  // Piano-specific fields
  pianoType      String?  // Grand, Upright, Digital, etc.
  pianoCondition String?  // Excellent, Good, Fair, Needs Tuning
  pianoBrand     String?  // Yamaha, Steinway, etc.
  lastTuned      String?  // Date or description of last tuning

  // Jam session fields
  jamSchedule    String?  // Description of jam session schedule
  jamFrequency   String?  // Weekly, Monthly, etc.
  jamGenres      String[] // Array of music genres

  // Operational details (curator-editable)
  operatingHours       Json?    // Operating hours structured data
  wheelchairAccessible Boolean  @default(false)
  parkingAvailable     Boolean  @default(false)
  publicTransportNear  Boolean  @default(false)
  specialNotes         String?  @db.Text // Special notes/atmosphere
  accessibility        Json?    // Additional accessibility features
  ambiance             Json?    // Ambiance/atmosphere tags

  // Curator fields
  curatorNotes   String?  @db.Text // Internal curator notes
  curatorRating  Int?     // 1-5 curator rating
  followUpNeeded Boolean  @default(false) // Flag for follow-up needed

  // Ratings and reviews (PostgreSQL-only)
  rating       Float?   @default(0) // Average rating
  reviewCount  Int      @default(0) // Number of reviews

  // Verification (references blockchain but no sync needed)
  verified     Boolean  @default(false) // Manually updated from blockchain events
  verifiedAt   DateTime? // When verification was completed
  venueHash    String?  @unique // Hash used for blockchain verification

  // Rejection tracking
  rejectedAt     DateTime? // When venue was rejected by curator
  rejectedBy     String?   // Wallet address of curator who rejected
  rejectionReason String?  @db.Text // Required reason for rejection

  // QR Code settings
  qrCodeGenerated Boolean  @default(false) // Whether QR code has been generated
  qrCardStyle     Json?    // QR card theme and layout preferences
  defaultPayment  Float?   // Default PXP payment amount for tips

  // Soft delete tracking
  isActive        Boolean   @default(true)  // Active vs soft-deleted
  deletedAt       DateTime? // When venue was soft-deleted
  deletedBy       String?   // Username/wallet of admin who deleted
  deletionReason  String?   @db.Text // Reason for deletion

  // Metadata
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  reviews      VenueReview[]
  verifications VenueVerification[]
  validations  VenueValidation[]
  analytics    VenueAnalytics[]
  events       Event[] // Events hosted at this venue
  eventSeries  EventSeries[] // Recurring event series at this venue
  photos       VenuePhoto[] // Community-uploaded venue photos

  // Indexes for performance
  @@index([city, verified, isActive])
  @@index([hasPiano, verified, isActive])
  @@index([latitude, longitude])
  @@index([submittedBy])
  @@index([venueHash])
  @@index([name, city])  // For text search
  @@index([isActive])    // For filtering soft-deleted venues
}

// User profiles - supports both wallet and username/password auth
model User {
  id             Int      @id @default(autoincrement())
  walletAddress  String?  @unique @db.VarChar(42) // Ethereum address format (nullable for username/password users)

  // Authentication fields
  username       String?  @unique // For username/password auth
  passwordHash   String?  // bcrypt hash for username/password auth
  role           UserRole @default(SCOUT) // User role for RBAC
  createdBy      String?  // Admin wallet/username who created this user
  isActive       Boolean  @default(true) // Account active status

  // Profile information
  displayName    String?
  email          String?  @unique
  bio            String?  @db.Text
  avatar         String?  // IPFS hash or URL
  location       String?
  profileSlug    String?  @unique // Custom URL slug for profile

  // Professional info
  title          String?  // Professional title (e.g., "Jazz Pianist")
  skills         String[] // Array of skills/tags
  socialLinks    Json?    // Twitter, LinkedIn, GitHub, etc.

  // Web3 profile
  ensName        String?  // ENS domain name
  profileNFT     String?  // Profile picture NFT

  // PXP-related fields (cached from blockchain)
  totalPXPEarned Float    @default(0) // Total PXP earned (cached)
  hasClaimedNewUserReward Boolean @default(false) // Cached from contract
  isAuthorizedVerifier   Boolean @default(false) // Cached from contract

  // User badges
  badges         String[] // Array of earned badge IDs

  // Email verification (Web 2.5 authentication)
  emailVerified           Boolean   @default(false)  // Email verification status
  emailVerifiedAt         DateTime? // When email was verified
  emailVerificationToken  String?   @unique          // Token for email verification
  emailVerificationExpiry DateTime? // Token expiration time

  // Password reset
  passwordResetToken      String?   @unique          // Token for password reset
  passwordResetExpiry     DateTime? // Password reset token expiration time

  // Profile completion tracking
  profileCompleted              Boolean   @default(false)  // Profile setup completed
  profileCompletedAt            DateTime? // When profile was completed
  musicianProfileCompleted      Boolean   @default(false)  // Musician profile bonus PXP awarded
  musicianProfileCompletedAt    DateTime? // When musician profile bonus was awarded

  // Onboarding tracking (new users)
  onboardingCompleted     Boolean   @default(false)  // Onboarding wizard completed
  onboardingStep          Int?      // Current step in onboarding (1-4)
  userInterests           String[]  @default([])     // Selected interests during onboarding
  lastOnboardingNudge     DateTime? // Last time onboarding reminder was shown

  // Migration tracking (wallet-only users)
  emailAddedAt            DateTime? // When email was added to wallet account
  emailReminderDismissedAt DateTime? // Last time migration reminder was dismissed

  // Wallet linking tracking (for username/password users)
  walletLinkingPromptDismissedAt DateTime? // When user dismissed wallet linking prompt
  walletLinkingPromptShownCount  Int       @default(0) // Number of times prompt was shown
  firstPXPEarnedAt               DateTime? // When user earned their first PXP

  // Embedded wallet tracking (for OAuth/email users via Reown)
  walletType              String?   // "embedded" | "external" | "linked"
  authProvider            String?   // "google" | "email" | "wallet" | "credentials"
  embeddedWalletCreatedAt DateTime? // When embedded wallet was auto-created

  // YouTube OAuth integration (for channel verification)
  youtubeChannelId       String?   @unique // Verified YouTube channel ID
  youtubeChannelName     String?   // Channel display name
  youtubeAccessToken     String?   // OAuth access token (encrypted)
  youtubeRefreshToken    String?   // OAuth refresh token (encrypted)
  youtubeTokenExpiry     DateTime? // When access token expires
  youtubeVerifiedAt      DateTime? // When channel was verified

  // Referral system
  referralCode           String?   @unique // User's unique referral code (e.g., "PIANIST123")
  referredBy             String?   // Referral code of who invited them
  referredByUser         User?     @relation("Referrals", fields: [referredBy], references: [referralCode])
  referrals              User[]    @relation("Referrals") // Users this user referred
  referralPXPEarned      Float     @default(0) // Total PXP earned from referrals
  referralCount          Int       @default(0) // Count of successful referrals

  // Privacy settings
  publicProfile  Boolean  @default(true)  // Profile visibility
  showPXPBalance Boolean  @default(true)  // Show token balance publicly

  // QR Code settings
  qrCardStyle    Json?    // Saved QR card theme preferences

  // Activity tracking
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  lastActive     DateTime @default(now())

  // Relations
  reviews         VenueReview[]
  sessions        Session[]
  validations     VenueValidation[]
  musicianProfile MusicianProfile? // One-to-one relation with musician profile
  organizedEvents Event[]          @relation("OrganizedEvents") // Events created by this user
  organizedSeries EventSeries[]    @relation("OrganizedSeries") // Event series created by this user
  rsvps           EventRSVP[]      @relation("EventRSVPs") // Events this user RSVPed to
  youtubeVideos   YouTubeVideo[]   // Submitted YouTube videos for PXP rewards
  venuePhotos     VenuePhoto[]     // Photos uploaded by this user
  notifications   Notification[]   // In-app notifications

  @@index([walletAddress])
  @@index([username])
  @@index([profileSlug])
  @@index([totalPXPEarned])
  @@index([role])
  @@index([emailVerificationToken])
  @@index([emailVerified])
  @@index([passwordResetToken])
  @@index([referralCode])
  @@index([referredBy])
}

// User reviews (PostgreSQL-only for performance)
model VenueReview {
  id          Int      @id @default(autoincrement())
  venue       Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)
  venueId     Int
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      Int

  // Review content
  rating      Int      // 1-5 stars
  title       String?
  content     String?  @db.Text
  pianoQuality Int?    // Piano-specific rating

  // Moderation
  isVerified   Boolean @default(false) // Verified review
  isHidden     Boolean @default(false) // Hidden by moderators

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([venueId, rating])
  @@index([userId])
  @@unique([venueId, userId]) // One review per user per venue
}

// Venue verifications (references blockchain transactions)
model VenueVerification {
  id          Int      @id @default(autoincrement())
  venue       Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)
  venueId     Int

  // Verification details
  verifierAddress String // Curator wallet address
  approved    Boolean
  notes       String?  @db.Text
  rating      Int?     // 1-5 star rating from curator
  timestamp   DateTime @default(now())

  // Blockchain reference (for transparency)
  transactionHash String? @unique // Reference to blockchain tx
  blockNumber     Int?    // Block number

  @@index([venueId, approved])
  @@index([verifierAddress])
}

// Multi-signature venue validation system (3 validators required)
model VenueValidation {
  id          Int      @id @default(autoincrement())
  venue       Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)
  venueId     Int
  validator   User     @relation(fields: [validatorId], references: [id], onDelete: Cascade)
  validatorId Int

  // Validation decision
  approved    Boolean  // true = approve, false = reject
  notes       String?  @db.Text // Validator notes
  rating      Int?     // 1-5 star rating from validator

  // Metadata
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([venueId, validatorId]) // Each validator can only vote once per venue
  @@index([venueId, approved])
  @@index([validatorId])
}

// Session management for username/password auth
model Session {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int
  token     String   @unique // JWT token
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
}

// PXP payment tracking (blockchain transaction references)
model PXPPayment {
  id               Int         @id @default(autoincrement())

  // Payment participants
  fromAddress      String      // Sender wallet
  toAddress        String      // Recipient wallet
  venueId          Int?        // Optional venue reference

  // Payment details
  amount           Float       // Amount in PXP tokens

  // Blockchain tracking
  transactionHash  String      @unique // Blockchain transaction hash
  blockNumber      Int?        // Block number
  blockTimestamp   DateTime    // Transaction timestamp
  status           PaymentStatus @default(CONFIRMED) // Assume confirmed when recorded

  // Payment context
  paymentType      String      // venue_payment, reward, tip, etc.
  memo             String?
  paymentMethod    String      // web3, qr

  createdAt        DateTime    @default(now())

  @@index([venueId, status])
  @@index([fromAddress])
  @@index([toAddress])
  @@index([transactionHash])
  @@index([blockTimestamp])
}

// Analytics (PostgreSQL-only for performance)
model VenueAnalytics {
  id          Int      @id @default(autoincrement())
  venue       Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)
  venueId     Int
  date        DateTime @db.Date

  // View metrics
  views       Int      @default(0)
  uniqueViews Int      @default(0)
  qrScans     Int      @default(0)

  // Engagement metrics
  detailViews Int      @default(0)
  shareClicks Int      @default(0)

  // Search metrics
  searchImpressions Int @default(0)
  searchClicks      Int @default(0)

  @@unique([venueId, date])
  @@index([date])
}

// Community-uploaded venue photos — one PXP award per user per venue
model VenuePhoto {
  id         Int      @id @default(autoincrement())
  venue      Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)
  venueId    Int
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     Int
  url        String   // URL or IPFS hash of the photo
  pxpAwarded Boolean  @default(false) // Whether the venue_photo PXP was issued for this upload

  createdAt  DateTime @default(now())

  @@unique([venueId, userId, url]) // Prevent duplicate awards for same photo
  @@index([venueId])
  @@index([userId])
}

// App configuration
model AppConfig {
  id            Int      @id @default(autoincrement())
  key           String   @unique
  value         Json
  description   String?
  updatedAt     DateTime @updatedAt

  @@index([key])
}

// PXP Reward Configuration (database-tracked rewards)
model PXPConfig {
  id          Int      @id @default(autoincrement())
  key         String   @unique // e.g., "referral_profile_created", "youtube_1000_views"
  value       Float    // PXP amount
  label       String   // Display name for admin UI
  description String?  // Description of when this reward is earned
  category    String   // "referral", "youtube", "event", "venue", etc.
  enabled     Boolean  @default(true) // Allow disabling specific rewards
  updatedAt   DateTime @updatedAt
  updatedBy   String?  // Admin who last updated (wallet address or username)

  @@index([category])
  @@index([enabled])
}

// Blockchain event log (for tracking important events)
model BlockchainEvent {
  id          Int      @id @default(autoincrement())
  eventType   String   // NewUserRewarded, ScoutRewarded, VenueVerified, etc.
  contractAddress String // Contract that emitted the event
  transactionHash String @unique
  blockNumber Int
  blockTimestamp DateTime

  // Event data (JSON)
  eventData   Json

  // Processing status
  processed   Boolean  @default(false)
  processedAt DateTime?

  createdAt   DateTime @default(now())

  @@index([eventType, processed])
  @@index([blockNumber])
  @@index([contractAddress])
}

// In-app notification system (Sprint 3 Epic 4)
model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  type      String   // "REWARD_EARNED" | "VENUE_VERIFIED" | "VENUE_REJECTED" | "EVENT_REMINDER"
  title     String
  message   String   @db.Text
  link      String?  // Optional deep-link (e.g. /venues/123)
  pxpAmount Float?   // For reward notifications, the amount earned

  read      Boolean  @default(false)
  readAt    DateTime?

  createdAt DateTime @default(now())

  @@index([userId, read])
  @@index([userId, createdAt])
}

// Simplified enums
enum PaymentStatus {
  PENDING
  CONFIRMED
  FAILED
}

// Musician profile for marketing in the community
model MusicianProfile {
  id                  Int      @id @default(autoincrement())
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId              Int      @unique

  // WPB-109: Instruments
  instruments         String[] // Array of instrument names (e.g., ["Piano", "Guitar", "Drums"])

  // WPB-110: Musical styles & genres
  musicalStyles       String[] // e.g., ["Jazz", "Classical", "Blues"]
  genres              String[] // Sub-genres

  // WPB-111: Experience level
  experienceLevel     String?  // "Beginner", "Intermediate", "Advanced", "Professional"
  yearsPlaying        Int?     // Years of experience

  // WPB-112: Availability
  availableForGigs    Boolean  @default(false)
  availableForCollab  Boolean  @default(false)
  availabilityNotes   String?  @db.Text

  // WPB-113: Performance portfolio
  recordingLinks      String[] // YouTube, SoundCloud, etc.
  socialMedia         Json?    // {youtube: "", instagram: "", tiktok: "", etc.}

  // WPB-114: Repertoire
  repertoire          String[] // List of songs/pieces they know

  // Influences
  influences          String[] // Artists or bands that inspire them

  // Metadata
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([userId])
}

// WPB-208: Events System
model Event {
  id              Int      @id @default(autoincrement())

  // Event organizer (creator)
  organizer       User     @relation("OrganizedEvents", fields: [organizerId], references: [id], onDelete: Cascade)
  organizerId     Int

  // Event details
  title           String
  description     String   @db.Text
  eventType       EventType // Jam Session, Gig, Concert, Meetup, etc.

  // Location
  venue           Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)
  venueId         Int      // Required - every event must have a venue
  address         String?  // Physical address (optional additional details)
  latitude        Float?   // For map display
  longitude       Float?   // For map display

  // Scheduling
  startDate       DateTime
  endDate         DateTime
  timezone        String   @default("America/New_York")

  // Event settings
  maxAttendees    Int?     // null = unlimited
  requireApproval Boolean  @default(false) // Organizer must approve RSVPs
  isPublic        Boolean  @default(true)  // Public or private event
  isFree          Boolean  @default(true)
  price           Float?   // Price in USD if not free

  // Rich content
  coverImage      String?  // Event banner/poster
  genres          String[] // Music genres for the event
  tags            String[] // Searchable tags

  // External links
  externalLink    String?  // Eventbrite, Bandsintown, etc.
  streamingLink   String?  // For virtual/hybrid events

  // Status
  status          EventStatus @default(UPCOMING)
  cancelledAt     DateTime?
  cancellationReason String? @db.Text

  // Series relation (optional - null for standalone events)
  series            EventSeries? @relation("SeriesEvents", fields: [seriesId], references: [id], onDelete: SetNull)
  seriesId          Int?
  seriesOccurrence  Int?         // Which occurrence in series (1, 2, 3...)
  isSeriesException Boolean      @default(false)  // True if edited independently

  // Metadata
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  rsvps           EventRSVP[]
  youtubeVideos   YouTubeVideo[] // Performance videos from this event

  @@index([organizerId])
  @@index([venueId])
  @@index([startDate, status])
  @@index([eventType, status])
  @@index([isPublic, status])
  @@index([seriesId])
}

// EventSeries - Recurring event template that spawns individual Event instances
model EventSeries {
  id                Int       @id @default(autoincrement())

  // Organizer (same as Event)
  organizer         User      @relation("OrganizedSeries", fields: [organizerId], references: [id], onDelete: Cascade)
  organizerId       Int

  // Template fields (copied to each Event instance)
  title             String
  description       String    @db.Text
  eventType         EventType
  venueId           Int
  venue             Venue     @relation(fields: [venueId], references: [id], onDelete: Cascade)

  // Time template (time of day, duration)
  startTime         String    // "19:00" - time portion only
  endTime           String    // "21:00" - time portion only
  timezone          String    @default("America/New_York")

  // Event settings (copied to instances)
  maxAttendees      Int?
  requireApproval   Boolean   @default(false)
  isPublic          Boolean   @default(true)
  isFree            Boolean   @default(true)
  price             Float?
  genres            String[]
  coverImage        String?
  externalLink      String?
  streamingLink     String?

  // Recurrence configuration
  recurrencePattern RecurrencePattern
  recurrenceConfig  Json      // Pattern-specific config (see types/event.ts)
  seriesStartDate   DateTime  // First occurrence
  seriesEndDate     DateTime  // Last occurrence (max 1 year from start)

  // Status
  status            EventSeriesStatus @default(ACTIVE)
  cancelledAt       DateTime?
  cancellationReason String?  @db.Text

  // Metadata
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Relations
  events            Event[]   @relation("SeriesEvents")

  @@index([organizerId])
  @@index([venueId])
  @@index([recurrencePattern])
  @@index([seriesEndDate])
  @@index([status])
}

enum EventSeriesStatus {
  ACTIVE
  PAUSED
  CANCELLED
  COMPLETED
}

// WPB-211: Event RSVP system
model EventRSVP {
  id          Int      @id @default(autoincrement())
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId     Int
  user        User     @relation("EventRSVPs", fields: [userId], references: [id], onDelete: Cascade)
  userId      Int

  // RSVP status
  status      RSVPStatus @default(PENDING)

  // Additional info
  attendeeCount Int     @default(1) // For "+1" guests
  notes         String? @db.Text    // Special requests/notes

  // Performer tracking
  isPerformer         Boolean @default(false) // Marked as performer at this event (by organizer)
  performerPXPAwarded Boolean @default(false) // Whether event_perform PXP was already awarded

  // Timestamps
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  respondedAt DateTime? // When status changed from PENDING

  @@unique([eventId, userId]) // One RSVP per user per event
  @@index([eventId, status])
  @@index([userId])
}

enum EventType {
  JAM_SESSION
  GIG
  CONCERT
  RECITAL
  OPEN_MIC
  WORKSHOP
  MASTERCLASS
  REHEARSAL
  MEETUP
  OTHER
}

enum EventStatus {
  UPCOMING
  ONGOING
  COMPLETED
  CANCELLED
}

enum RecurrencePattern {
  DAILY           // Every day or every N days
  WEEKLY          // Specific day(s) of week
  MONTHLY         // Same date or Nth weekday of month
  WEEKDAYS        // Monday-Friday
}

enum RSVPStatus {
  PENDING      // Waiting for organizer approval (if required)
  CONFIRMED    // Attending
  DECLINED     // Not attending
  MAYBE        // Tentative
  WAITLIST     // On waitlist (when event is full)
}

// YouTube videos submitted for PXP rewards
model YouTubeVideo {
  id            Int      @id @default(autoincrement())

  // Event relationship (required - videos document performances at events)
  event         Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId       Int

  // User relationship (performer/uploader)
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        Int

  // YouTube video details
  youtubeUrl    String   // Full YouTube URL
  youtubeId     String   @unique // YouTube video ID (extracted from URL)
  channelId     String?  // YouTube channel ID (for verification)
  channelName   String?  // Channel display name

  // Video metadata
  title         String   // Video title
  description   String?  @db.Text // Video description
  thumbnailUrl  String?  // Thumbnail image URL
  duration      Int?     // Duration in seconds
  publishedAt   DateTime? // When video was published on YouTube

  // View tracking
  viewCount     Int      @default(0) // Current view count
  lastChecked   DateTime? // Last time views were checked

  // PXP tracking
  pxpAwarded    Int      @default(0) // Total PXP awarded for this video
  initialPXPAwarded Boolean @default(false) // 100 PXP for submission
  milestone1kAwarded Boolean @default(false) // 150 PXP for 1k views
  milestone10kAwarded Boolean @default(false) // 200 PXP for 10k views

  // Verification
  verified      Boolean  @default(false) // Channel ownership verified
  verifiedAt    DateTime? // When verification completed
  verificationToken String? @unique // OAuth verification token

  // Status
  status        YouTubeVideoStatus @default(PENDING)
  rejectionReason String? @db.Text // Reason if rejected

  // Timestamps
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([eventId, createdAt]) // Videos by event
  @@index([userId, createdAt])  // Videos by user
  @@index([youtubeId])
  @@index([status, verified])
  @@index([viewCount])
}

enum YouTubeVideoStatus {
  PENDING      // Awaiting verification
  VERIFIED     // Channel ownership verified
  APPROVED     // Approved for PXP rewards
  REJECTED     // Rejected (not piano-related, etc.)
  REMOVED      // Video removed from YouTube
}

// Gas-sponsored transaction tracking (for monitoring and rate limiting)
model GasSponsoredTransaction {
  id              Int      @id @default(autoincrement())

  // User who made the transaction
  userId          Int
  userAddress     String   // Wallet address of user (for tracking across accounts)

  // Transaction details
  method          String   // submitVenue, rsvpToEvent, updateProfile, etc.
  transactionHash String   @unique // Blockchain transaction hash
  blockNumber     Int?     // Block number

  // Cost tracking (estimated)
  gasUsed         Int?     // Actual gas used (if available)
  gasCostUSD      Float?   // Estimated cost in USD
  gasCostCELO     Float?   // Estimated cost in CELO

  // Context
  relatedEntityId Int?     // ID of venue/event/etc. related to this transaction
  relatedEntityType String? // "venue", "event", "profile", etc.

  // Rate limiting tracking
  dailyCount      Int      @default(1) // Count for rate limit tracking

  // Status
  status          GasTransactionStatus @default(CONFIRMED)
  errorMessage    String?  @db.Text // Error if transaction failed

  // Timestamps
  createdAt       DateTime @default(now())
  processedAt     DateTime? // When cost was calculated/processed

  @@index([userId, createdAt])
  @@index([userAddress, createdAt])
  @@index([method, createdAt])
  @@index([transactionHash])
  @@index([createdAt]) // For time-based queries (daily/weekly/monthly)
}

enum GasTransactionStatus {
  PENDING
  CONFIRMED
  FAILED
  REFUNDED
}

enum VenueType {
  CAFE
  RESTAURANT
  BAR
  CLUB
  COMMUNITY_CENTER
  HOTEL
  LIBRARY
  SCHOOL
  OTHER
}

// User roles for RBAC
enum UserRole {
  BLOG_OWNER  // Full CRUD, instant verification
  CURATOR     // Edit venues, no verification power
  VALIDATOR   // Vote to verify venues (3 required)
  SCOUT       // Create venues, read all (default role)
}

