# Piano Blog Environment Variables

# Database - Supabase PostgreSQL
DATABASE_URL="postgresql://postgres:[YOUR_PASSWORD]@db.xxxxx.supabase.co:5432/postgres"

# Supabase API Configuration
NEXT_PUBLIC_SUPABASE_URL="https://xxxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Blog Owner Wallet Address
NEXT_PUBLIC_BLOG_OWNER_ADDRESS="0xYourWalletAddressHere"

# JWT Authentication (REQUIRED for RBAC system)
# Generate a strong random secret (min 32 characters)
# Example: openssl rand -base64 32
JWT_SECRET="your-secret-key-change-in-production-min-32-chars"

# Analytics (Optional)
NEXT_UMAMI_ID=""

# Comments System (Optional)
NEXT_PUBLIC_GISCUS_REPO=""
NEXT_PUBLIC_GISCUS_REPOSITORY_ID=""
NEXT_PUBLIC_GISCUS_CATEGORY=""
NEXT_PUBLIC_GISCUS_CATEGORY_ID=""

# Email Service (Resend) - Required for email verification
# Sign up at https://resend.com to get your API key
RESEND_API_KEY="re_xxxxxxxxxxxxx"
EMAIL_FROM="Piano Blog <onboarding@resend.dev>"

# App URL (for email links)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Venue Address Auto-fill
# Now uses OpenStreetMap Nominatim (free, no API key required)
# No configuration needed!

# Legacy Email Config (Deprecated - use Resend instead)
EMAIL_SERVER=""
