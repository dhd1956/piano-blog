# Piano Blog Environment Variables

# Database - Supabase PostgreSQL
DATABASE_URL="postgresql://postgres:[YOUR_PASSWORD]@db.xxxxx.supabase.co:5432/postgres"

# Supabase API Configuration
NEXT_PUBLIC_SUPABASE_URL="https://xxxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Blog Owner Wallet Address
NEXT_PUBLIC_BLOG_OWNER_ADDRESS="0xYourWalletAddressHere"

# JWT Authentication (REQUIRED for RBAC system)
# Generate a strong random secret (min 32 characters)
# Example: openssl rand -base64 32
JWT_SECRET="your-secret-key-change-in-production-min-32-chars"

# Analytics (Optional)
NEXT_UMAMI_ID=""

# Comments System (Optional)
NEXT_PUBLIC_GISCUS_REPO=""
NEXT_PUBLIC_GISCUS_REPOSITORY_ID=""
NEXT_PUBLIC_GISCUS_CATEGORY=""
NEXT_PUBLIC_GISCUS_CATEGORY_ID=""

# Email Service (Resend) - Required for email verification
# Sign up at https://resend.com to get your API key
RESEND_API_KEY="re_xxxxxxxxxxxxx"
EMAIL_FROM="Piano Blog <onboarding@resend.dev>"

# App URL (for email links)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Gas Sponsorship (Paymaster) - Optional but RECOMMENDED
# Enables gasless transactions for users - they don't need CELO tokens to interact
# Sign up at https://pimlico.io or https://biconomy.io to get started
# Cost: ~$25-30/month for 100 daily active users
NEXT_PUBLIC_PAYMASTER_URL="https://api.pimlico.io/v2/celo-sepolia/rpc"
NEXT_PUBLIC_PIMLICO_API_KEY="your-pimlico-api-key"

# Reown (WalletConnect) Project ID
# Get your project ID from https://cloud.reown.com/
NEXT_PUBLIC_REOWN_PROJECT_ID="your-reown-project-id"

# Venue Address Auto-fill
# Now uses OpenStreetMap Nominatim (free, no API key required)
# No configuration needed!

# YouTube Integration (Optional - for PXP rewards via video uploads)
# Get your API key from https://console.cloud.google.com/apis/credentials
# Enable YouTube Data API v3 in your Google Cloud project
# Quota: 10,000 units/day (free tier) - enough for ~200 video checks/day
YOUTUBE_API_KEY="your-youtube-api-key"

# YouTube OAuth (Optional - for channel ownership verification)
# Required to verify users own the videos they submit (prevents fraud)
# Create OAuth 2.0 credentials in Google Cloud Console:
# 1. Go to https://console.cloud.google.com/apis/credentials
# 2. Create OAuth 2.0 Client ID (Web application)
# 3. Add authorized redirect URI: http://localhost:3000/api/content/youtube/oauth/callback
#    For production: https://yourdomain.com/api/content/youtube/oauth/callback
# 4. Enable YouTube Data API v3
YOUTUBE_OAUTH_CLIENT_ID="your-google-oauth-client-id.apps.googleusercontent.com"
YOUTUBE_OAUTH_CLIENT_SECRET="your-google-oauth-client-secret"
YOUTUBE_OAUTH_REDIRECT_URI="http://localhost:3000/api/content/youtube/oauth/callback"

# Cron Job Security (Required for automated tasks)
# Used to protect cron endpoints (view count tracking, etc.)
# Generate a strong random secret: openssl rand -base64 32
CRON_SECRET="your-cron-secret-change-in-production"

# Legacy Email Config (Deprecated - use Resend instead)
EMAIL_SERVER=""
